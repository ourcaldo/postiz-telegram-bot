# Copy to /opt/postiz-bot/.env and fill in real values. Never commit real values.
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
POSTIZ_URL=https://postiz.digitalloka.dev/api/public/v1
POSTIZ_API_KEY=your-postiz-api-key
# Comma-separated Telegram user IDs allowed to use the bot. Empty = anyone.
ALLOWED_USER_IDS=
DOWNLOAD_DIR=/tmp/postiz-media
# Cloudflare Workers AI (optional; auto-generate caption from video audio)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_IDS=
CLOUDFLARE_API_TOKEN=

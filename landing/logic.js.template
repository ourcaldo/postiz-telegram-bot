// Bio landing page: instagram-bio_v4 design, per-channel product lists.
// GET  /{channel}      -> <=200 products: full list directly. >200: batch cards.
// GET  /{channel}/p/N  -> batch N list (N=1 is newest)
// POST /{channel}/add  -> {name, url} + X-Webhook-Secret header -> {ok, num}

const PAGE_SIZE = 200;
const CHANNELS = new Set(["instagram", "threads", "x", "tiktok", "facebook", "youtube"]);
const DISCOUNT_URL = "https://s.shopee.co.id/70Kvirqv6u";

const esc = (s) =>
  String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

const LINK_ICONS = ["mint", "rose", "blue", "yellow"];
const iconSvg = (i) => [SVG_CAT1, SVG_CAT2, SVG_CAT3, SVG_CAT4][i % 4];

const html = (channel, main) => `<!DOCTYPE html>
<html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Emak Emak Suka Belanja — Rekomendasi Belanja</title>
<meta name="description" content="Temukan rekomendasi barang untuk rumah, kecantikan, dan kebutuhan sehari-hari dari Emak Emak Suka Belanja.">
<meta property="og:title" content="Emak Emak Suka Belanja — Link Belanja"><meta property="og:description" content="Barang lucu, barang berguna, dan rekomendasi belanja pilihan emak."><meta property="og:type" content="website"><meta name="twitter:card" content="summary_large_image">
<style>${CSS}</style></head>
<body>
<main class="page"><header class="topline"><a class="monogram" href="/${channel}" aria-label="Beranda Emak Emak Suka Belanja">eesb<span>✳</span></a><div class="top-actions"><span class="status">Racun belanja pilihan</span><button class="icon-button" id="share" aria-label="Bagikan halaman ini" title="Bagikan halaman ini">${SVG_SHARE}</button></div></header>
<section class="profile" aria-label="Emak Emak Suka Belanja"><div class="brand-avatar">${SVG_BRAND}<span class="brand-spark">✳</span></div><h1>Emak Emak<br><span>Suka Belanja.</span>${SVG_CHECK}</h1><p class="handle">@emakemaksukabelanja</p><p class="bio"><strong>Barang lucu, barang berguna. Emak suka! 🛍️</strong><br>Teman cari barang buat rumah &amp; diri sendiri.</p><nav class="socials" aria-label="Media sosial"><a href="https://www.instagram.com/emakemaksukabelanja/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">${SVG_INSTA}<span>Instagram</span></a><a href="https://threads.net/@emakemaksukabelanja" target="_blank" rel="noopener noreferrer" aria-label="Threads" title="Threads">${SVG_THREADS}<span>Threads</span></a></nav></section>
<div class="section-label">Pilihan emak</div><a class="featured" href="${DISCOUNT_URL}" target="_blank" rel="noopener noreferrer"><img src="${FEATURED_IMG}" alt="Pilihan kebutuhan sehari-hari: tumbler, wadah makanan, handuk, dan perlengkapan kecantikan" width="1200" height="640"><span class="feature-tag">Diskon hingga <b>90%</b></span><div class="feature-bottom"><div><h2>Kecil barangnya.<br>Besar manfaatnya.</h2><p>Pernak-pernik rumah yang bikin jatuh hati.</p></div><span class="feature-arrow">${SVG_FARROW}</span></div></a>
${main}
<footer class="footer"><p class="signature">Belanja senang, emak pun senang <span>✳</span></p><p class="disclosure">Akun rekomendasi &amp; afiliasi belanja.</p><div class="footer-line">© 2026 Emak Emak Suka Belanja</div></footer></main><div role="status" class="toast" id="toast"></div>
<script>const share=document.getElementById('share');const toast=document.getElementById('toast');let timer;function notify(message){toast.textContent=message;toast.classList.add('show');clearTimeout(timer);timer=setTimeout(()=>toast.classList.remove('show'),3000)}share.addEventListener('click',async()=>{const url=window.parent===window?location.href:document.referrer||location.href;try{if(navigator.share){await navigator.share({title:document.title,url})}else if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(url);notify('Link disalin. Bagikan ke teman belanja!')}else{window.prompt('Salin link halaman ini:',url)}}catch(error){if(error.name!=='AbortError')notify('Belum bisa dibagikan. Salin link dari alamat halaman.')}});</script></body></html>`;

const productMain = (rows, label) => `
<div class="section-label">${esc(label)}</div>
<nav class="links" aria-label="Produk rekomendasi">${rows
  .map(
    (r, i) => `<a class="link" href="${esc(r.url)}" target="_blank" rel="noopener noreferrer">
      <span class="link-icon ${LINK_ICONS[i % 4]}">${iconSvg(i)}</span>
      <span><h2>No. ${r.num} — ${esc(r.name)}</h2><p>Klik untuk buka produk.</p></span>
      ${SVG_ARROW}</a>`
  )
  .join("")}</nav>`;

const batchMain = (channel, total) => {
  const batches = Math.ceil(total / PAGE_SIZE);
  let cards = "";
  for (let b = 1; b <= batches; b++) {
    const end = total - (b - 1) * PAGE_SIZE;
    const start = Math.max(1, end - PAGE_SIZE + 1);
    cards += `<a class="link" href="/${channel}/p/${b}">
      <span class="link-icon ${LINK_ICONS[b % 4]}">${iconSvg(b)}</span>
      <span><h2>Produk No. ${start} - ${end}</h2><p>Klik untuk lihat daftar produk.</p></span>
      ${SVG_ARROW}</a>`;
  }
  return `<div class="section-label">Mau belanja apa?</div><nav class="links" aria-label="Batch produk">${cards}</nav>`;
};

const emptyMain = `<div class="section-label">Produk rekomendasi</div>
<nav class="links" aria-label="Produk rekomendasi">
<p class="bio" style="text-align:center">Belum ada produk 🛍️ — produk akan muncul di sini otomatis.</p></nav>`;

async function count(env, channel) {
  const r = await env.DB.prepare("SELECT COUNT(*) AS c FROM products WHERE channel = ?")
    .bind(channel)
    .first();
  return r.c;
}

async function fetchRange(env, channel, start, end) {
  const rows = await env.DB.prepare(
    "SELECT num, name, url FROM products WHERE channel = ? AND num BETWEEN ? AND ? ORDER BY num DESC"
  )
    .bind(channel, start, end)
    .all();
  return rows.results;
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const parts = url.pathname.split("/").filter(Boolean);

    // POST /{channel}/add — webhook from bot
    if (
      request.method === "POST" &&
      parts.length === 2 &&
      parts[1] === "add" &&
      CHANNELS.has(parts[0])
    ) {
      if (request.headers.get("x-webhook-secret") !== env.WEBHOOK_SECRET) {
        return Response.json({ ok: false, error: "unauthorized" }, { status: 401 });
      }
      let body;
      try {
        body = await request.json();
      } catch {
        return Response.json({ ok: false, error: "bad json" }, { status: 400 });
      }
      const { name, url: purl } = body || {};
      if (!name || !purl || !/^https?:\/\//.test(purl)) {
        return Response.json({ ok: false, error: "name and http(s) url required" }, { status: 400 });
      }
      const channel = parts[0];
      const next = await env.DB.prepare(
        "SELECT COALESCE(MAX(num), 0) + 1 AS n FROM products WHERE channel = ?"
      )
        .bind(channel)
        .first();
      await env.DB.prepare(
        "INSERT INTO products (channel, num, name, url) VALUES (?, ?, ?, ?)"
      )
        .bind(channel, next.n, name, purl)
        .run();
      return Response.json({ ok: true, num: next.n });
    }

    // GET /{channel} or /{channel}/p/N — public pages
    if (request.method === "GET" && parts.length >= 1 && CHANNELS.has(parts[0])) {
      const channel = parts[0];
      if (parts.length === 1) {
        const total = await count(env, channel);
        let main;
        if (total === 0) main = emptyMain;
        else if (total <= PAGE_SIZE) {
          const rows = await fetchRange(env, channel, 1, total);
          main = productMain(rows, total === 1 ? "Produk rekomendasi" : `Produk rekomendasi (${total})`);
        } else main = batchMain(channel, total);
        return new Response(html(channel, main), {
          headers: { "content-type": "text/html; charset=utf-8" },
        });
      }
      if (parts.length === 3 && parts[1] === "p" && /^\d+$/.test(parts[2])) {
        const b = parseInt(parts[2], 10);
        const total = await count(env, channel);
        if (total > PAGE_SIZE && b >= 1 && b <= Math.ceil(total / PAGE_SIZE)) {
          const end = total - (b - 1) * PAGE_SIZE;
          const start = Math.max(1, end - PAGE_SIZE + 1);
          const rows = await fetchRange(env, channel, start, end);
          return new Response(html(channel, productMain(rows, `Produk No. ${start} - ${end}`)), {
            headers: { "content-type": "text/html; charset=utf-8" },
          });
        }
      }
    }

    return new Response("Not found", { status: 404 });
  },
};
